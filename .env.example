# Copy to .env and fill in.
# MySQL (create the DB first: mysql -u <user> -p < database/schema_mysql.sql)
SQL_DATABASE_URL=mysql+pymysql://<user>:<password>@localhost:3306/beijing_air_quality
# Or, with no MySQL server available, SQLite works with the same code:
# SQL_DATABASE_URL=sqlite:///./beijing_air_quality.db

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=beijing_air_quality
MONGO_COLLECTION=air_quality_readings

# Hosted MySQL (e.g. Aiven) needs TLS:
# SQL_DATABASE_URL=mysql+pymysql://avnadmin:<password>@<host>:<port>/defaultdb
# SQL_SSL=true
# SQL_SSL_CA=ca.pem        # optional: Aiven's CA certificate, to also verify the server
